# Supabase transaction-pooler URI for the declaration_runtime database role.
DATABASE_URL=

# Supabase session-pooler URI (port 5432) for the declaration_provisioner role.
# Used only for game creation, one-time invitation redemption, and seat recovery.
DECLARATION_PROVISIONING_DATABASE_URL=

# Supabase direct PostgreSQL URI for migrations only. Never used by runtime code.
MIGRATION_DATABASE_URL=

# Local-only PostgreSQL/Supabase integration-test URI. The test suite rejects
# every non-loopback host; never provide staging or production here.
DECLARATION_TEST_DATABASE_URL=

# Exact browser origin accepted by POST /api/games/[gameId]/actions.
DECLARATION_APP_ORIGIN=http://localhost:3000

# Optional credential lifetime for trusted provisioning (60 seconds–90 days).
DECLARATION_SEAT_TTL_SECONDS=604800

# Required for production Vercel traffic and any Vercel staging/preview that
# exercises these routes. The shared limiter fails closed when any value is
# missing, invalid, or unavailable. Store them in a secret manager; do not
# expose them through NEXT_PUBLIC_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A canonical base64url encoding of at least 32 cryptographically random bytes.
DECLARATION_RATE_LIMIT_KEY_SECRET=
